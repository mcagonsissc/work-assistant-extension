{
  "name": "ai-workday-assistant",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config vite.background.config.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:extension": "playwright test --config playwright.extension.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/chrome": "^0.0.306",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.0"
  }
}
