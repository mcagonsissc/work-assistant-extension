{
  "manifest_version": 3,
  "name": "AI Workday Assistant",
  "version": "0.6.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "alarms",
    "notifications",
    "storage"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://openrouter.ai https://api.openai.com https://auth.openai.com https://generativelanguage.googleapis.com https://api.anthropic.com"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://auth.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "http://127.0.0.1/*"
  ]
}
